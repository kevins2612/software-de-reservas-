# Clase base para todas las entidades (no se puede instanciar)
class EntidadBase(ABC):
    _contador = 0  # lleva la cuenta para dar ids

    def __init__(self):
        EntidadBase._contador += 1
        self._id = EntidadBase._contador
        self._fecha_creacion = datetime.now()

    @property
    def id(self):
        return self._id

    # Cada clase hija debe escribir su propia descripcion
    @abstractmethod
    def describir(self):
        pass

    def __str__(self):
        return self.describir()


# ---------------------------------------------------------
# CLIENTE
# ---------------------------------------------------------

class Cliente(EntidadBase):
    # Patron simple para revisar el correo
    _PATRON_EMAIL = re.compile(r"^[\w.+-]+@[\w-]+\.[\w.-]+$")

    def __init__(self, nombre=None, documento=None, email=None, telefono=None):
        super().__init__()
        # Atributos privados (encapsulacion)
        self.__nombre = None
        self.__documento = None
        self.__email = None
        self.__telefono = None
        # Al asignar se llaman los setters que validan
        self.nombre = nombre
        self.documento = documento
        self.email = email
        self.telefono = telefono

    # --- nombre ---
    @property
    def nombre(self):
        return self.__nombre

    @nombre.setter
    def nombre(self, valor):
        if valor is None:
            raise ClienteInvalidoError("Falta el nombre")
        if not isinstance(valor, str) or len(valor.strip()) < 3:
            raise ClienteInvalidoError(f"Nombre invalido: {valor!r}")
        if any(c.isdigit() for c in valor):
            raise ClienteInvalidoError("El nombre no puede tener numeros")
        self.__nombre = valor.strip().title()

    # --- documento ---
    @property
    def documento(self):
        return self.__documento

    @documento.setter
    def documento(self, valor):
        if valor is None:
            raise ClienteInvalidoError("Falta el documento")
        valor = str(valor).strip()
        if not valor.isdigit() or not (6 <= len(valor) <= 12):
            raise ClienteInvalidoError(f"Documento invalido: {valor!r} (6 a 12 digitos)")
        self.__documento = valor

    # --- email ---
    @property
    def email(self):
        return self.__email

    @email.setter
    def email(self, valor):
        if valor is None:
            raise ClienteInvalidoError("Falta el email")
        if not isinstance(valor, str) or not self._PATRON_EMAIL.match(valor.strip()):
            raise ClienteInvalidoError(f"Email invalido: {valor!r}")
        self.__email = valor.strip().lower()

    # --- telefono ---
    @property
    def telefono(self):
        return self.__telefono

    @telefono.setter
    def telefono(self, valor):
        if valor is None:
            raise ClienteInvalidoError("Falta el telefono")
        valor = str(valor).strip()
        if not valor.isdigit() or len(valor) != 10:
            raise ClienteInvalidoError(f"Telefono invalido: {valor!r} (10 digitos)")
        self.__telefono = valor

    # Valida un solo dato (nombre, documento, email o telefono)
    # Se usa en el menu para repetir solo el dato que estuvo mal
    @staticmethod
    def validar_campo(campo, valor):
        temporal = Cliente.__new__(Cliente)  # cliente vacio, solo para usar los setters
        setattr(temporal, campo, valor)      # aqui se valida
        return getattr(temporal, campo)      # devuelve el dato ya limpio

    def describir(self):
        return f"Cliente #{self.id}: {self.nombre} | Doc: {self.documento} | {self.email}"


