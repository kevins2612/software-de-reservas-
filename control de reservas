# EXCEPCIONES PERSONALIZADAS
# ---------------------------------------------------------

# Excepcion base, las demas heredan de esta
class SoftwareFJError(Exception):
    pass


# Cuando los datos del cliente estan mal
class ClienteInvalidoError(SoftwareFJError):
    pass


# Cuando los datos de un servicio estan mal
class ServicioInvalidoError(SoftwareFJError):
    pass


# Cuando el servicio no se puede reservar
class ServicioNoDisponibleError(SoftwareFJError):
    pass


# Cuando la reserva tiene datos incorrectos
class ReservaInvalidaError(SoftwareFJError):
    pass


# Cuando se hace algo que no se puede en ese estado
class OperacionNoPermitidaError(SoftwareFJError):
    pass


# Cuando un calculo da un resultado raro
class CalculoInconsistenteError(SoftwareFJError):
    pass


# No es un error: se usa cuando el usuario elige "0" para volver atras
class VolverAtras(Exception):
    pass


# ---------------------------------------------------------
# CLASE ABSTRACTA GENERAL
