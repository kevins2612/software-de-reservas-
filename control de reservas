# Pide un dato y lo repite SOLO ese dato hasta que sea valido
# "validar" es una funcion que devuelve el dato bien o lanza un error
def pedir(mensaje, validar):
    while True:
        valor = input(mensaje).strip()
        if valor.lower() == "cancelar":
            raise OperacionNoPermitidaError("Operacion cancelada por el usuario")
        try:
            return validar(valor if valor else None)  # vacio = dato faltante
        except SoftwareFJError as e:
            # Se guarda el error en el log y se avisa, pero no se sale
            logger.error("Dato invalido en '%s': [%s] %s", mensaje.strip(), type(e).__name__, e)
            print(f"    [ALERTA] {e}. Intenta de nuevo.")


# ----- Validadores pequenos (cada uno revisa un tipo de dato) -----
def a_numero(valor):
    if valor is None:
        raise SoftwareFJError("Falta el dato")
    try:
        return float(valor.replace(",", "."))
    except ValueError as e:
        raise SoftwareFJError("Debes escribir un numero valido") from e


def a_entero(valor):
    if valor is None:
        raise SoftwareFJError("Falta el dato")
    try:
        return int(valor)
    except ValueError as e:
        raise SoftwareFJError("Debes escribir un numero entero") from e


def texto_obligatorio(nombre_dato):
    def validar(valor):
        if valor is None:
            raise ServicioInvalidoError(f"Falta {nombre_dato}")
        return valor
    return validar


def en_rango(minimo, maximo):
    def validar(valor):
        n = a_entero(valor)
        if not minimo <= n <= maximo:
            raise SoftwareFJError(f"Elige un numero entre {minimo} y {maximo}")
        return n
    return validar


def numero_positivo(valor):
    n = a_numero(valor)
    if n <= 0:
        raise ServicioInvalidoError("Debe ser mayor que 0")
    return n


def numero_no_negativo(valor):
    n = a_numero(valor)
    if n < 0:
        raise ServicioInvalidoError("No puede ser negativo")
    return n


def entero_positivo(valor):
    n = a_entero(valor)
    if n <= 0:
        raise ServicioInvalidoError("Debe ser mayor que 0")
    return n


def nivel_valido(valor):
    if valor is None or valor.lower() not in ("junior", "senior"):
        raise ServicioInvalidoError("El nivel debe ser junior o senior")
    return valor.lower()


def porcentaje(nombre, maximo):
    def validar(valor):
        n = a_numero(valor)
        if not 0 <= n <= maximo:
            raise CalculoInconsistenteError(f"{nombre} fuera de rango (0 a {maximo})")
        return n
    return validar


