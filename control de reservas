        print("5. Procesar reserva (calcular costo)")
        print("6. Cancelar reserva")
        print("7. Ver clientes, servicios y reservas")
        print("8. Ejecutar simulacion automatica (22 operaciones)")
        print("9. Ver el log")
        print("0. Salir")

        try:
            opcion = input("Elige una opcion: ").strip()
