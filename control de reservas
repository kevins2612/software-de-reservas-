# GESTOR PRINCIPAL
# ---------------------------------------------------------

# Guarda todo en listas (no hay base de datos)
class GestorSoftwareFJ:
    def __init__(self):
        self._clientes = []
        self._servicios = []
        self._reservas = []

    # Ejecuta una operacion y atrapa los errores para que el programa no se caiga
    def _ejecutar(self, nombre_op, funcion):
        print(f"\n>>> {nombre_op}")
        logger.info("INICIO: %s", nombre_op)
        resultado = None
        try:
            resultado = funcion()
        except SoftwareFJError as e:
            # Error propio del sistema
            causa = f" (causa: {e.__cause__})" if e.__cause__ else ""
            logger.error("%s FALLO [%s]: %s%s", nombre_op, type(e).__name__, e, causa)
            print(f"    [ERROR CONTROLADO] {type(e).__name__}: {e}{causa}")
        except VolverAtras:
            # El usuario eligio volver al menu (no es un error)
            logger.info("%s: el usuario volvio al menu", nombre_op)
            print("    Volviste al menu principal")
        except Exception as e:
            # Cualquier otro error que no esperabamos
            logger.critical("%s ERROR INESPERADO [%s]: %s", nombre_op, type(e).__name__, e)
            print(f"    [ERROR INESPERADO] {type(e).__name__}: {e}")
        else:
            # Si no hubo error
            logger.info("EXITO: %s", nombre_op)
            print(f"    [OK] {resultado}")
        finally:
            # Esto se ejecuta siempre
            logger.info("FIN: %s", nombre_op)
        return resultado

    def registrar_cliente(self, **datos):
        cliente = Cliente(**datos)
        # No se permiten documentos repetidos
        if any(c.documento == cliente.documento for c in self._clientes):
            raise ClienteInvalidoError(f"Ya existe un cliente con documento {cliente.documento}")
        self._clientes.append(cliente)
        return cliente.describir()

    def registrar_servicio(self, clase, *args, **kwargs):
        servicio = clase(*args, **kwargs)
        self._servicios.append(servicio)
        return servicio.describir()

    # Busca un elemento en una lista (empieza en 0)
    # Se revisa que no sea negativo porque en Python -1 seria el ultimo
    def _obtener(self, lista, idx, nombre):
        try:
            if idx < 0:
                raise IndexError
            return lista[idx]
        except IndexError as e:
            raise ReservaInvalidaError(f"El {nombre} no existe") from e

    def crear_reserva(self, idx_cliente, idx_servicio, horas, confirmar=True):
        cliente = self._obtener(self._clientes, idx_cliente, "cliente")
        servicio = self._obtener(self._servicios, idx_servicio, "servicio")
        reserva = Reserva(cliente, servicio, horas)
        if confirmar:
            reserva.confirmar()
        self._reservas.append(reserva)
        return reserva.describir()

    def confirmar_reserva(self, idx):
        reserva = self._obtener(self._reservas, idx, "reserva")
        reserva.confirmar()
        return reserva.describir()

    def procesar_reserva(self, idx, *args):
        reserva = self._obtener(self._reservas, idx, "reserva")
        reserva.procesar(*args)
        return reserva.describir()

    def cancelar_reserva(self, idx):
        reserva = self._obtener(self._reservas, idx, "reserva")
        reserva.cancelar()
        return reserva.describir()

    def documento_existe(self, documento):
        return any(c.documento == documento for c in self._clientes)

    def servicio_en(self, idx):
        return self._obtener(self._servicios, idx, "servicio")

    def reserva_en(self, idx):
        return self._obtener(self._reservas, idx, "reserva")

    # Texto corto con la cantidad de datos (se muestra en el menu)
    def estado(self):
        return (f"Clientes: {len(self._clientes)} | Servicios: {len(self._servicios)} | "
                f"Reservas: {len(self._reservas)}")

    # Devuelven las listas como texto numerado (desde 1)
    def listar_clientes(self):
        return [f"{i}. {c.describir()}" for i, c in enumerate(self._clientes, 1)]

    def listar_servicios(self):
        return [f"{i}. {s.describir()}" for i, s in enumerate(self._servicios, 1)]

    def listar_reservas(self):
        return [f"{i}. {r.describir()}" for i, r in enumerate(self._reservas, 1)]

    # Muestra el resumen al final
    def resumen(self):
        print("\n" + "=" * 70)
        print("RESUMEN FINAL")
        print("=" * 70)
        print(f"Clientes: {len(self._clientes)} | Servicios: {len(self._servicios)} | "
              f"Reservas: {len(self._reservas)}")
        for r in self._reservas:
            print("  -", r.describir())
        print("Revisar 'software_fj.log' para ver los eventos y errores.")


