# Clase abstracta, de aqui salen los servicios especificos
class Servicio(EntidadBase, ABC):
    IVA = 0.19  # impuesto por defecto

    def __init__(self, nombre, tarifa_hora, disponible=True):
        super().__init__()
        self._validar_base(nombre, tarifa_hora)
        self._nombre = nombre.strip()
        self._tarifa_hora = float(tarifa_hora)
        self._disponible = bool(disponible)

    # Revisa el nombre y la tarifa
    @staticmethod
    def _validar_base(nombre, tarifa):
        if not isinstance(nombre, str) or not nombre.strip():
            raise ServicioInvalidoError("El nombre del servicio es obligatorio")
        if not isinstance(tarifa, (int, float)) or isinstance(tarifa, bool) or tarifa <= 0:
            raise ServicioInvalidoError(f"Tarifa invalida: {tarifa!r}")

    @property
    def nombre(self):
        return self._nombre

    @property
    def tarifa_hora(self):
        return self._tarifa_hora

    @property
    def disponible(self):
        return self._disponible

    @disponible.setter
    def disponible(self, valor):
        self._disponible = bool(valor)

    # Metodos abstractos: cada servicio los hace a su manera (polimorfismo)
    @abstractmethod
    def calcular_costo_base(self, horas):
        pass

    @abstractmethod
    def validar_parametros(self, horas):
        pass

    # Metodo sobrecargado: se puede llamar de varias formas
    #   calcular_costo(horas)
    #   calcular_costo(horas, impuesto)
    #   calcular_costo(horas, impuesto, descuento)
    #   calcular_costo(horas, descuento=0.1)
    def calcular_costo(self, horas, *args, impuesto=None, descuento=None):
        if len(args) > 2:
            raise CalculoInconsistenteError("Demasiados argumentos")
        if len(args) >= 1:
            impuesto = args[0]
        if len(args) == 2:
            descuento = args[1]

        self.validar_parametros(horas)
        costo = self.calcular_costo_base(horas)

        # Se aplica el descuento si lo hay
        if descuento is not None:
            if not 0 <= descuento < 1:
                raise CalculoInconsistenteError(f"Descuento fuera de rango: {descuento}")
            costo -= costo * descuento

        # Se aplica el impuesto si lo hay
        if impuesto is not None:
            if not 0 <= impuesto <= 1:
                raise CalculoInconsistenteError(f"Impuesto fuera de rango: {impuesto}")
            costo += costo * impuesto

        if costo <= 0:
            raise CalculoInconsistenteError(f"Costo inconsistente: {costo}")
        return round(costo, 2)

    def describir(self):
        estado = "Disponible" if self._disponible else "No disponible"
        return f"{self.__class__.__name__} #{self.id}: {self.nombre} (${self.tarifa_hora:,.0f}/h) [{estado}]"


# Servicio 1: reserva de salas
class ReservaSala(Servicio):
    def __init__(self, nombre, tarifa_hora, capacidad, disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if not isinstance(capacidad, int) or capacidad <= 0:
            raise ServicioInvalidoError(f"Capacidad invalida: {capacidad!r}")
        self._capacidad = capacidad

    # Una sala se reserva de 1 a 12 horas
    def validar_parametros(self, horas):
        if not isinstance(horas, (int, float)) or not 1 <= horas <= 12:
            raise ServicioInvalidoError("Una sala se reserva entre 1 y 12 horas")

    def calcular_costo_base(self, horas):
        return self.tarifa_hora * horas

    def describir(self):
        return super().describir() + f" | Capacidad: {self._capacidad} personas"


# Servicio 2: alquiler de equipos
class AlquilerEquipo(Servicio):
    def __init__(self, nombre, tarifa_hora, tipo_equipo, deposito=0, disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if not tipo_equipo or not isinstance(tipo_equipo, str):
            raise ServicioInvalidoError("El tipo de equipo es obligatorio")
        if deposito < 0:
            raise ServicioInvalidoError("El deposito no puede ser negativo")
        self._tipo_equipo = tipo_equipo
        self._deposito = deposito

    # Un equipo se alquila de 1 a 72 horas
    def validar_parametros(self, horas):
        if not isinstance(horas, (int, float)) or not 1 <= horas <= 72:
            raise ServicioInvalidoError("Un equipo se alquila entre 1 y 72 horas")

    # Aqui se suma el deposito al costo
    def calcular_costo_base(self, horas):
        return self.tarifa_hora * horas + self._deposito

    def describir(self):
        return super().describir() + f" | Equipo: {self._tipo_equipo} | Deposito: ${self._deposito:,.0f}"


# Servicio 3: asesorias especializadas
class AsesoriaEspecializada(Servicio):
    def __init__(self, nombre, tarifa_hora, especialidad, nivel="junior", disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if nivel not in ("junior", "senior"):
            raise ServicioInvalidoError(f"Nivel invalido: {nivel!r}")
        if not especialidad:
            raise ServicioInvalidoError("La especialidad es obligatoria")
        self._especialidad = especialidad
        self._nivel = nivel

    # Una asesoria dura de media hora a 8 horas
    def validar_parametros(self, horas):
        if not isinstance(horas, (int, float)) or not 0.5 <= horas <= 8:
            raise ServicioInvalidoError("Una asesoria dura entre 0.5 y 8 horas")

    # El asesor senior cobra 50% mas
    def calcular_costo_base(self, horas):
        recargo = 1.5 if self._nivel == "senior" else 1.0
        return self.tarifa_hora * horas * recargo

    def describir(self):
        return super().describir() + f" | Especialidad: {self._especialidad} ({self._nivel})"


# ---------------------------------------------------------
# RESERVA
# ---------------------------------------------------------

class Reserva(EntidadBase):
    # Estados posibles de una reserva
    PENDIENTE = "PENDIENTE"
    CONFIRMADA = "CONFIRMADA"
    CANCELADA = "CANCELADA"
    PROCESADA = "PROCESADA"

    def __init__(self, cliente, servicio, horas):
        super().__init__()
        # Se revisa que los datos sean correctos
        if not isinstance(cliente, Cliente):
            raise ReservaInvalidaError("Se necesita un Cliente valido")
        if not isinstance(servicio, Servicio):
            raise ReservaInvalidaError("Se necesita un Servicio valido")
        if not servicio.disponible:
            raise ServicioNoDisponibleError(f"El servicio '{servicio.nombre}' no esta disponible")
        try:
            servicio.validar_parametros(horas)
        except ServicioInvalidoError as e:
            # Encadenamiento: se conserva el error original con "from e"
            raise ReservaInvalidaError(f"Duracion invalida: {horas!r}") from e
        self._cliente = cliente
        self._servicio = servicio
        self._horas = horas
        self._estado = Reserva.PENDIENTE
        self._costo_final = None

    @property
    def estado(self):
        return self._estado

    @property
    def costo_final(self):
        return self._costo_final

    # Solo se confirma si esta pendiente
    def confirmar(self):
        if self._estado != Reserva.PENDIENTE:
            raise OperacionNoPermitidaError(f"No se puede confirmar, estado actual: {self._estado}")
        self._estado = Reserva.CONFIRMADA

    # No se cancela si ya esta cancelada o procesada
    def cancelar(self):
        if self._estado in (Reserva.CANCELADA, Reserva.PROCESADA):
            raise OperacionNoPermitidaError(f"No se puede cancelar, estado actual: {self._estado}")
        self._estado = Reserva.CANCELADA

    # Metodo sobrecargado:
    #   procesar()                    -> usa IVA por defecto
    #   procesar(descuento)           -> IVA por defecto y descuento
    #   procesar(impuesto, descuento) -> los dos personalizados
    def procesar(self, *args):
        if self._estado != Reserva.CONFIRMADA:
            raise OperacionNoPermitidaError(f"Solo se procesan reservas confirmadas (estado: {self._estado})")
        try:
            if len(args) == 0:
                costo = self._servicio.calcular_costo(self._horas, Servicio.IVA)
            elif len(args) == 1:
                costo = self._servicio.calcular_costo(self._horas, Servicio.IVA, args[0])
            elif len(args) == 2:
                costo = self._servicio.calcular_costo(self._horas, args[0], args[1])
            else:
                raise CalculoInconsistenteError("procesar() recibe maximo 2 argumentos")
        except CalculoInconsistenteError as e:
            raise ReservaInvalidaError("No se pudo procesar la reserva") from e
        else:
            # Si todo salio bien se guarda el costo y cambia el estado
            self._costo_final = costo
            self._estado = Reserva.PROCESADA
            return costo

    def describir(self):
        texto = (f"Reserva #{self.id} [{self._estado}] {self._cliente.nombre} -> "
                 f"{self._servicio.nombre} x {self._horas}h")
        if self._costo_final:
            texto += f" = ${self._costo_final:,.2f}"
        return texto


