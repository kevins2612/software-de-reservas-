# Valida una opcion de lista: el 0 significa volver atras
def opcion_o_volver(maximo):
    def validar(valor):
        n = a_entero(valor)
        if n == 0:
            raise VolverAtras()
        if not 1 <= n <= maximo:
            raise SoftwareFJError(f"Elige un numero entre 0 y {maximo}")
        return n
    return validar


def menu_registrar_servicio(g):
    while True:
        print("\nTipo de servicio:")
        print("    1. Sala")
        print("    2. Equipo")
        print("    3. Asesoria")
        print("    0. Volver al menu")
        # Si elige 0 sale al menu principal
        tipo = str(pedir("Elige el tipo: ", opcion_o_volver(3)))

        titulo, clase, opciones = CATALOGO[tipo]

        # Se muestran las opciones que ofrece la empresa
        print(f"\nOpciones de {titulo}:")
        for i, (nombre, tarifa, extra) in enumerate(opciones, 1):
            detalle = ", ".join(f"{k}: {v}" for k, v in extra.items())
            print(f"    {i}. {nombre} (${tarifa:,.0f}/h) - {detalle}")
        print(f"    {len(opciones) + 1}. Otro (escribir los datos a mano)")
        print("    0. Volver atras")

        try:
            eleccion = pedir("Elige una opcion: ", opcion_o_volver(len(opciones) + 1))
        except VolverAtras:
            continue  # vuelve a elegir el tipo de servicio

        # Opcion del catalogo
        if eleccion <= len(opciones):
            nombre, tarifa, extra = opciones[eleccion - 1]
            return g.registrar_servicio(clase, nombre, tarifa, **extra)

        # Opcion manual (cada dato se pide y se valida por separado)
        nombre = pedir("Nombre del servicio: ", texto_obligatorio("el nombre"))
        tarifa = pedir("Tarifa por hora: ", numero_positivo)
        if tipo == "1":
            capacidad = pedir("Capacidad (personas): ", entero_positivo)
            return g.registrar_servicio(ReservaSala, nombre, tarifa, capacidad)
        if tipo == "2":
            equipo = pedir("Tipo de equipo: ", texto_obligatorio("el tipo de equipo"))
            deposito = pedir("Deposito: ", numero_no_negativo)
            return g.registrar_servicio(AlquilerEquipo, nombre, tarifa, equipo, deposito=deposito)
        especialidad = pedir("Especialidad: ", texto_obligatorio("la especialidad"))
        nivel = pedir("Nivel (junior/senior): ", nivel_valido)
        return g.registrar_servicio(AsesoriaEspecializada, nombre, tarifa, especialidad, nivel)


# ----- Reservas -----
def mostrar_numerada(lista_texto, si_esta_vacia):
    if not lista_texto:
        raise ReservaInvalidaError(si_esta_vacia)
    for linea in lista_texto:
        print("   ", linea)


# Elige una reserva y revisa que este en un estado permitido (0 = volver)
def elegir_reserva(g, estados_ok):
    lista = g.listar_reservas()
    mostrar_numerada(lista, "No hay reservas. Primero crea una con la opcion 3")
    print("    0. Volver al menu")

    def validar(valor):
        n = opcion_o_volver(len(lista))(valor)
        estado = g.reserva_en(n - 1).estado
        if estado not in estados_ok:
            raise OperacionNoPermitidaError(
                f"La reserva {n} esta {estado}, se necesita una {' o '.join(estados_ok)}")
        return n - 1

    return pedir("Numero de la reserva: ", validar)


def menu_crear_reserva(g):
    clientes = g.listar_clientes()
    if not clientes:
        raise ReservaInvalidaError("No hay clientes. Primero registra uno con la opcion 1")
    servicios = g.listar_servicios()
    if not servicios:
        raise ReservaInvalidaError("No hay servicios. Primero registra uno con la opcion 2")

    def validar_servicio(valor):
        n = opcion_o_volver(len(servicios))(valor)
        servicio = g.servicio_en(n - 1)
        if not servicio.disponible:
            raise ServicioNoDisponibleError(f"El servicio '{servicio.nombre}' no esta disponible")
        return n - 1

    # Se hace por pasos: 1 cliente, 2 servicio, 3 horas
    # Con 0 se vuelve al paso anterior (en el paso 1 se vuelve al menu)
    paso = 1
    while True:
        try:
            if paso == 1:
                print("\nClientes:")
                mostrar_numerada(clientes, "")
                print("    0. Volver al menu")
                c = pedir("Numero del cliente: ", opcion_o_volver(len(clientes))) - 1
                paso = 2
            elif paso == 2:
                print("\nServicios:")
                mostrar_numerada(servicios, "")
                print("    0. Volver atras")
                s = pedir("Numero del servicio: ", validar_servicio)
                paso = 3
            else:
                servicio = g.servicio_en(s)

                # Las horas se revisan con las reglas del servicio elegido
                def validar_horas(valor):
                    horas = a_numero(valor)
                    if horas == 0:
                        raise VolverAtras()
                    try:
                        servicio.validar_parametros(horas)
                    except ServicioInvalidoError as e:
                        raise ReservaInvalidaError(f"Duracion invalida: {horas} ({e})") from e
                    return horas

                horas = pedir("\nCantidad de horas (0 para volver atras): ", validar_horas)
                # Se crea PENDIENTE, despues se confirma con la opcion 4
                return g.crear_reserva(c, s, horas, confirmar=False)
        except VolverAtras:
            if paso == 1:
                raise  # en el primer paso se sale al menu principal
            paso -= 1


def menu_confirmar_reserva(g):
    r = elegir_reserva(g, (Reserva.PENDIENTE,))
    return g.confirmar_reserva(r)


def menu_cancelar_reserva(g):
    r = elegir_reserva(g, (Reserva.PENDIENTE, Reserva.CONFIRMADA))
    return g.cancelar_reserva(r)


def menu_procesar_reserva(g):
    while True:
        print("Reservas (se pueden procesar las CONFIRMADAS):")
        r = elegir_reserva(g, (Reserva.CONFIRMADA,))  # 0 sale al menu principal

        while True:
            print("\nComo quieres calcular el costo?")
            print("    1. Normal (con IVA del 19%)")
            print("    2. Con IVA del 19% y un descuento")
            print("    3. Personalizado (escribir IVA y descuento)")
            print("    0. Volver atras")
            try:
                opcion = pedir("Elige una opcion: ", opcion_o_volver(3))
            except VolverAtras:
                break  # vuelve a elegir la reserva

            # Opcion 1: sin parametros (sobrecarga)
            if opcion == 1:
                return g.procesar_reserva(r)

            # Opcion 2: un parametro (sobrecarga)
            if opcion == 2:
                print("\nDescuento:")
                print("    1. 5%")
                print("    2. 10%")
                print("    3. 15%")
                print("    0. Volver atras")
                try:
                    d = pedir("Elige una opcion: ", opcion_o_volver(3))
                except VolverAtras:
                    continue  # vuelve a elegir como calcular
                return g.procesar_reserva(r, {1: 0.05, 2: 0.10, 3: 0.15}[d])

            # Opcion 3: dos parametros (sobrecarga)
            iva = pedir("IVA (ej 0.19): ", porcentaje("El IVA", 1))
            descuento = pedir("Descuento (ej 0.10): ", porcentaje("El descuento", 0.99))
            return g.procesar_reserva(r, iva, descuento)


