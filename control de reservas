# Muestra las ultimas lineas del archivo de log
def ver_log():
    print(f"\n--- LOG ({RUTA_LOG}) ---")
    try:
        with open(RUTA_LOG, "r", encoding="utf-8") as archivo:
            for linea in archivo.readlines()[-25:]:
                print(linea.rstrip())
    except FileNotFoundError:
        print("    Todavia no existe el archivo de log")


